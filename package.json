{
  "name": "monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "This a Node and Typescript Monorepo.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:site\"",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:site": "npm run dev --workspace=apps/site",
    "build": "npm run build --workspaces --if-present"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/morteza-rostami-cs/node-monorepo.git"
  },
  "keywords": [
    "node",
    "monorepo",
    "typescript"
  ],
  "author": "morteza",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/morteza-rostami-cs/node-monorepo/issues"
  },
  "homepage": "https://github.com/morteza-rostami-cs/node-monorepo#readme",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
